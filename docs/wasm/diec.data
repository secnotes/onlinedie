// https://github.com/praeclarum/sqlite-net (.NET)
meta("library", "SQLite");

function detect() {
    var sLibrary = PE.isLibraryPresentExp(/sqlite\d+/i);
    if (sLibrary) {
        var match = /sqlite(\d+)/i.exec(sLibrary);

        if (match) {
            sVersion = match[1];
        }

        bDetected = true;
    } else {
