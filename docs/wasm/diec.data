            sVersion = "1.15-1.18";
            sOptions = "LZMA";
        } else if (PE.compareEP("33FFE8", nEP + 55)) {
            sVersion = "1.19-1.20";
            sOptions = "aPlib";
        } else if (PE.compareEP("33FF6A", nEP + 55)) {
            sVersion = "1.19-1.20";
            sOptions = "LZMA";
        } else if (PE.compareEP("EB0FFF", nEP + 56)) {
            sVersion = "1.17 Full Edition";
            sOptions = "aPLib";
        } else if (PE.compareEP("6A4068", nEP + 51)) {
            sVersion = "1.17 Full Edition";
            sOptions = "LZMA";
        } else if (PE.compareEP("33ffe8", nEP + 60)) {
            sVersion = "1.21";
            sOptions = "aPLib";
        }

        bDetected = true;
    } else if (PE.getNumberOfImports() === 1 && PE.compareEP("60") && PE.isSectionNamePresent(".RLPack")) {
        bDetected = true;
    } else if (PE.compareEP("eb$$9c60e8........33c08bc483c0..938be3")) {
        sVersion = "1.16-1.21";
        bDetected = true;
    }

    return result();
}
