meta("source", "XML");

function detect() {
    var sText = Binary.getHeaderString();
    // Ignore the UTF-8 BOM.
    if (/^(?:\xef\xbb\xbf)?<\?xml/.test(sText)) {
        var aVersion = sText.match(/version="(.*?)"/);
        if (aVersion) {
            sVersion = aVersion[1];
        }

        bDetected = true;
    }

    return result();
}
