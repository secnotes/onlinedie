        sVersion = "1995"; // EXE32, console
        bDetected = true;
    } else if (PE.compareEP("e9$$$$$$$$535657558b7424..8b7c24..8b6c24..83ff..0f87........2eff")) {
        sVersion = "2000"; // DLL32
