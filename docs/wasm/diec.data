meta("data", "");

function detect() {
    if (Binary.isOverlay()) {
        if (Binary.compare("'aWAW'")) {
            sName = "CreateInstall data";
            bDetected = true;
        } else if (Binary.compare("';!@Install@!UTF-8!'")) {
            sName = "7-zip Installer data";
