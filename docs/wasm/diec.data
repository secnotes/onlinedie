        sVersion = "1995"; // DLL32
        bDetected = true;
    } else if (PE.compareEP("e9$$$$$$$$535589e583ec..b8........e8........a1........83c0..24..29c489e38b15")) {
        sVersion = "1995 EXE32, console";
        bDetected = true;
