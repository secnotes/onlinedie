		t = X.U16(a1,_BE); a1 += 2; if(t == 0x1FF) continue;
		t <<= 4; t += d1; a2 = t; if(t > X.Sz()) return false;
		for(; !found && a2 < X.Sz(); ) {
			var effe = X.c("EFFE",a2); a2 += 2;
