            if (PE.isNetObjectPresent("SuppressIldasmAttribute")) {
                sOptions = sOptions.append("Anti-ILDASM");
            }

            if (PE.isNetObjectPresent("Form200")) {
                sOptions = sOptions.append("Anti-de4dot");
            }
        }

    }

    return result();
}// Detect It Easy: detection rule file
