				var is3 = X.c("0003",a2); a2 += 2;
				if(is3)
					if(X.U16(a2,_BE))
						if(X.U8(a2) || !X.U8(a2+3)) { found = true; break }
				a2 += 12
			}
		}
	}
	if(!found) return false
	return true
}
