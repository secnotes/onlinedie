		sName = "Daniel Kahlin's VIC-TRACKER module (.VT)"; bDetected = 1;
		if(X.isVerbose()) {
			sOptionT(X.SA(0x19E,0x10)); //TODO? https://c64os.com/post/Vic20C64SuperChart
			x = 0; minst = 0xFFF; maxed = 0;
			for(p=0xA; p < 0x42; p+=4) {
				if(!X.U8(p+1)) continue;
				minst = Math.min(minst,X.U8(p)); maxed = Math.max(maxed,X.U8(p+1)); x++
			}
			for(ptn=0,p=0x3C2; p < 0x7C2; p++) ptn = Math.max(X.U8(p),ptn); ptn++;
			if(x > 1) sOption(x,'×');
			sOptionT(X.SA(0x1AE,0x10),"by: "); sOptionT(X.SA(0x1BE,0x10),"'");
			sOption('ptn:'+ptn+' sz:'+outSz(0x8C2+0x40*ptn))
		}
	}

	else if(X.fSig(X.Sz()-0x20,TOEOF,"'VSS0'00") > -1) {
