meta("protector", "CodeCrypt");

function detect() {
    if (PE.compareEP("E9........EB02833D58EB02FF1D5BEB020FC75F")) {
        switch (PE.readDword(PE.getEntryPointOffset() + 1)) {
            case 0x2c5: sVersion = "0.14b"; break;
