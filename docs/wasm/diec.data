		}
		if(bad != '') sVersion = sVersion.appendS("malformed"+bad,'/')
	}

	else if(X.Sz() > 0x8C2 && X.c("0033'T1'") && [1,2].includes(X.U8(4)) && X.U8(5) <= 1 && X.U8(6) <= 10
	  && !X.U16(7) && X.U8(9) && X.U8(0xC) <= X.U8(0xB)) {
