		sName = "Tomas Partl's Voodoo Supreme Synthesizer audio (.VSS)"; bDetected = 1
	}

	else if(X.c("6000") && X.c("48E7FFFE610000",0x04)
		&& X.c("4CDF7FFF'Nu'",0x0C)) {
